# === Banco de dados ===
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco
DB_PASSWORD=gere-uma-senha-aleatoria-com-pelo-menos-16-caracteres
APP_ENV=production
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000

# === Autenticação JWT ===
# Gere com: openssl rand -hex 32
SECRET_KEY=GERE-COM-openssl-rand-hex-32
FIELD_ENCRYPTION_KEY=GERE-COM-python-scripts/setup_encryption_key.py
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === CORS ===
# Origens autorizadas separadas por virgula. Nunca use * com cookies.
ALLOWED_ORIGINS=https://seudominio.com.br

# === HTTPS / Cookie Secure ===
# true em producao (exige HTTPS no servidor)
HTTPS_ONLY=true

# === Upload de arquivos ===
UPLOAD_DIR=uploads

# === E-mail (alertas de contas recorrentes) ===
# Gmail: ative "Senhas de app" em myaccount.google.com/security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=BPO Financeiro <seuemail@gmail.com>
