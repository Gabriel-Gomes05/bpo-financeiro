# Aplicação
APP_NAME=FLIC
APP_VERSION=1.0.0
APP_ENV=development
APP_URL=http://127.0.0.1:8888
HOST=0.0.0.0
PORT=8000
APP_PORT=8888
BIND_ADDRESS=0.0.0.0
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
WEB_CONCURRENCY=2
WEB_MEMORY_LIMIT=1g
WEB_CPUS=1.0
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# PostgreSQL local. Em produção, use URLs TLS fornecidas pela plataforma.
DB_NAME=flic
MIGRATION_DB_USER=flic_migrator
MIGRATION_DB_PASSWORD=GERE-UMA-SENHA-ALEATORIA
APP_DB_USER=flic_app
APP_DB_PASSWORD=GERE-OUTRA-SENHA-ALEATORIA
DATABASE_RUNTIME_ROLE=flic_app
MIGRATION_DATABASE_URL=postgresql://flic_migrator:SENHA@db:5432/flic
DATABASE_URL=postgresql://flic_app:SENHA@db:5432/flic
DB_SSL_MODE=disable
DB_ALLOW_INSECURE_PRIVATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000

# JWT e criptografia. Todas as chaves devem ser diferentes.
SECRET_KEY=GERE-64-OU-MAIS-CARACTERES-ALEATORIOS
FIELD_ENCRYPTION_KEY=GERE-COM-python-scripts-setup_local_env.py
BACKUP_ENCRYPTION_KEY=GERE-COM-python-scripts-setup_local_env.py
JWT_ALGORITHM=HS256
JWT_ISSUER=flic
JWT_AUDIENCE=flic-web
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis compartilhado para rate limit e revogação
REDIS_PASSWORD=GERE-UMA-SENHA-ALEATORIA
REDIS_URL=redis://:SENHA@redis:6379/0
LOGIN_RATE_LIMIT_ACCOUNT=5
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
GLOBAL_RATE_LIMIT_REQUESTS=300
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60

# Web e proxy. APP_URL define automaticamente HTTPS e a origem principal.
EXTRA_ALLOWED_ORIGINS=
INSECURE_PRIVATE_ORIGINS=http://192.168.0.102:8888
TRUSTED_PROXY_CIDRS=192.168.0.250/32
MAX_REQUEST_BODY_BYTES=12582912

# Arquivos
UPLOAD_DIR=/app/uploads

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FLIC <noreply@example.invalid>

# Adminer local
ADMINER_PORT=8080
